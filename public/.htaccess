# HTTPS is force-redirected at the Forpsi/Aruba proxy level (SSL redirect
# toggle in hosting panel) - no need to duplicate it here.

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript application/json image/svg+xml
</IfModule>

# Cache headers for static assets
<IfModule mod_expires.c>
  ExpiresActive On

  # Hashed build assets (filename changes on every deploy) - safe to cache long-term
  <FilesMatch "\.(js|css)$">
    ExpiresDefault "access plus 1 year"
  </FilesMatch>

  # Images
  <FilesMatch "\.(png|jpe?g|webp|gif|svg|ico)$">
    ExpiresDefault "access plus 1 month"
  </FilesMatch>

  # Fonts
  <FilesMatch "\.(woff2?|ttf|otf|eot)$">
    ExpiresDefault "access plus 1 year"
  </FilesMatch>

  # PDFs
  <FilesMatch "\.pdf$">
    ExpiresDefault "access plus 1 week"
  </FilesMatch>

  # HTML - always revalidate
  <FilesMatch "\.html$">
    ExpiresDefault "access plus 0 seconds"
  </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|ttf|otf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(png|jpe?g|webp|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # HSTS: start with a conservative 6-month max-age instead of the usual
  # 1 year/preload, since this is the first rollout of forced HTTPS on
  # this domain. Can be raised once confirmed stable.
  Header always set Strict-Transport-Security "max-age=15552000"
</IfModule>
